{
  "name": "emeriq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:clinical": "tsx evaluation/cli.ts",
    "eval:clinical:critical": "EVAL_SUITE=critical tsx evaluation/cli.ts",
    "eval:clinical:stability": "EVAL_SUITE=critical EVAL_REPEAT=3 tsx evaluation/cli.ts",
    "eval:clinical:blind": "tsx evaluation/blind/cli.ts",
    "eval:clinical:blind:stability": "EVAL_BLIND_SUITE=stability EVAL_REPEAT=3 tsx evaluation/blind/cli.ts",
    "eval:clinical:blind:human-review": "tsx evaluation/blind/human-review.ts",
    "eval:clinical:blind:hash": "tsx evaluation/blind/hash-cli.ts",
    "eval:clinical:complex": "tsx evaluation/complex-vignettes/cli.ts",
    "eval:clinical:complex:hard": "EVAL_COMPLEX_SUITE=hard tsx evaluation/complex-vignettes/cli.ts",
    "eval:clinical:complex:stability": "EVAL_COMPLEX_SUITE=stability EVAL_REPEAT=3 tsx evaluation/complex-vignettes/cli.ts",
    "eval:clinical:complex:hash": "tsx evaluation/complex-vignettes/hash-cli.ts",
    "release-check": "pnpm lint && pnpm typecheck && pnpm test && pnpm eval:clinical:critical && pnpm eval:clinical && pnpm build",
    "build:unsafe": "next build",
    "appwrite:setup": "tsx scripts/appwrite-setup.ts",
    "migrate:consultation-ownership": "tsx scripts/migrate-consultation-ownership.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "node-appwrite": "^28.0.0",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  }
}
