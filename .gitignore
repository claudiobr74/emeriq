# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# nested clone acidental
/emeriq/

# vercel / netlify
.vercel
.netlify

# typescript
*.tsbuildinfo
evaluation/reports/*.json
evaluation/reports/*.md
!evaluation/reports/.gitkeep
!evaluation/reports/failure-analysis-v1.3.md
!evaluation/reports/v1.3-before-after.md
!evaluation/reports/model-comparison-v1.3.md

