# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# nested clone acidental
/emeriq/

# vercel / netlify
.vercel
.netlify

# typescript
*.tsbuildinfo
evaluation/reports/*.json
evaluation/reports/*.md
evaluation/reports/dumps/
!evaluation/reports/.gitkeep
!evaluation/reports/failure-analysis-v1.3.md
!evaluation/reports/v1.3-before-after.md
!evaluation/reports/model-comparison-v1.3.md

# Blind holdout: FIRST_RUN is immutable and must be committed.
evaluation/blind/results/dumps/
evaluation/blind/results/*.json
evaluation/blind/results/*.md
!evaluation/blind/results/.gitkeep
!evaluation/blind/results/FIRST_RUN.json
!evaluation/blind/results/FIRST_RUN.md
!evaluation/blind/results/FIRST_RUN_FAILURE_ANALYSIS.md
!evaluation/blind/results/STABILITY_RUN.json
!evaluation/blind/results/STABILITY_RUN.md
!evaluation/blind/results/STABILITY_SUMMARY.md

# ECCV-1: FIRST_RUN is immutable and must be committed.
evaluation/complex-vignettes/v1/results/dumps/
evaluation/complex-vignettes/v1/results/*.json
evaluation/complex-vignettes/v1/results/*.md
!evaluation/complex-vignettes/v1/results/.gitkeep
!evaluation/complex-vignettes/v1/results/FIRST_RUN.json
!evaluation/complex-vignettes/v1/results/FIRST_RUN.md
!evaluation/complex-vignettes/v1/results/FAILURE_REPORT.md
!evaluation/complex-vignettes/v1/results/HARD_RUN.json
!evaluation/complex-vignettes/v1/results/HARD_RUN.md
!evaluation/complex-vignettes/v1/results/STABILITY_RUN.json
!evaluation/complex-vignettes/v1/results/STABILITY_RUN.md
!evaluation/complex-vignettes/v1/results/STABILITY_SUMMARY.md

# Next.js auto-generated agent rules
/AGENTS.md
/CLAUDE.md
